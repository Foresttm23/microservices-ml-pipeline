# Gateway edge settings
PORT=8000
ORCHESTRATOR_URL=http://orchestrator:8001
AUTH_URL=http://auth:8003

# HTTPX client
HTTPX_TIMEOUT_SECONDS=60
HTTPX_MAX_CONNECTIONS=100
HTTPX_MAX_KEEPALIVE_CONNECTIONS=20

# Redis Configuration (for WebSocket pub/sub bridge)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# JWT
JWT_ENABLED=true
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ISSUER=my-ai-platform-auth
JWT_AUDIENCE=my-ai-platform-services
JWT_USER_ID_CLAIM=sub
JWT_LEEWAY_SECONDS=0
JWT_PUBLIC_PATHS=["/","/health","/docs","/openapi.json","/auth/register","/auth/login","/auth/refresh","/auth/logout"]
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# WebSocket
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS=100
