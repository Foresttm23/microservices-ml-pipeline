# ML Worker service runtime
# NOTE: remove real API keys before committing. Use environment variables in CI or containers.
API_KEY=your_gemini_api_key_here
MODEL=gemini-2.5-flash-lite
API_BASE=https://generativelanguage.googleapis.com/v1
TIMEOUT_SECONDS=30
MAX_RETRIES=3
ML_WORKER_DRY_RUN=false

# Redis Configuration (for task queue and result publishing)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
